/*
 * mpCGC - marine polysaccharide CAZyme gene clusterer
 * https://github.com/AaronAOliver/mpCGC
 */

manifest {
    name            = 'AaronAOliver/mpCGC'
    author          = 'Aaron A. Oliver'
    homePage        = 'https://github.com/AaronAOliver/mpCGC'
    description     = 'Identify, mine and summarise carbohydrate-active enzyme gene clusters in marine genomes and MAGs'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
    defaultBranch   = 'main'
}

params {
    // ---- input / output -------------------------------------------------
    input           = null      // samplesheet CSV: sample,fasta[,taxonomy]
    metadata        = null      // optional TSV of per-genome metadata (taxonomy, gene counts)
    outdir          = 'results'
    db              = null      // dbCAN database directory
    db_from_s3      = false     // pull the pinned S3 release instead of db_current
    step            = 'all'     // identify | mine | summarize | all | download_db

    // ---- identification (orange dataflow) ------------------------------
    mode            = 'prok'    // prok | meta | protein
    gff_type        = 'prodigal' // GFF dialect: prodigal | NCBI_prok
    methods         = 'diamond,hmm,dbCANsub'
    e_value_cazyme  = 1e-102    // DIAMOND vs CAZy
    dbcansub        = true
    dbcansub        = true      // include the dbCAN-sub HMM step (subfamily calls)
    keep_ecami      = false     // keep dbCAN-sub eCAMI cluster indices (GH140_e33)

    // accessory-gene searches performed by dbCAN gff_process
    e_value_tc         = 1e-4
    coverage_tc        = 35
    e_value_tf         = 1e-4
    coverage_tf        = 35
    e_value_stp        = 1e-4
    coverage_stp       = 0.35
    e_value_sulfatase  = 1e-4
    coverage_sulfatase = 35
    e_value_peptidase  = 1e-4
    coverage_peptidase = 35

    // CGC calling (seed-and-extend). Defaults reproduce mpCGCdb / mpcgcdb.com.
    min_cluster_genes  = 2
    min_core_cazyme    = 1
    num_null_gene      = 2      // max intervening unannotated genes
    // Accessory classes a cluster must carry alongside its CAZyme core.
    // 'TC' with 'all' logic - a transporter is required - reproduces the
    // mpCGCdb cluster boundaries best (docs/validation.md compares the
    // alternatives). Widen it to admit clusters without a transporter, e.g.
    // --additional_genes CAZyme,TC --additional_logic any.
    additional_genes   = 'TC'
    additional_logic   = 'all' // all | any
    additional_min_categories = 1
    // Gene-boundary extension limit. mpCGCdb widens each called cluster by two
    // flanking genes on each side, which is what puts up to two unannotated
    // genes at a CGC boundary (see docs/validation.md).
    extend_mode        = 'gene' // none | bp | gene
    extend_gene_count  = 2
    extend_bp          = 0
    use_distance       = false
    base_pair_distance = 15000

    // ---- mining (green dataflow) ---------------------------------------
    mine_families     = null    // comma list, or null = every family in catalog
    min_family_seqs   = 4       // families below this are not aligned / trees skipped
    ssn_evalue        = 1e-30   // DIAMOND all-vs-all cutoff
    ssn_max_targets   = 0       // DIAMOND -k 0 (report all)
    leiden_resolution = 1.0
    muscle_super5_min = 1000    // switch MUSCLE to --super5 at/above this many seqs
    fasttree_model    = '-lg'
    fasttree_threads_bin = 'FastTreeMP'   // FastTree binary to call
    coloc_min_support = 2       // min CGCs supporting a colocalisation edge
    make_trees        = true
    make_tree_figures = false   // R/ggtree rendering (needs the ggtree env)
    tree_color_by     = 'taxonomy'  // taxonomy | community
    tree_color_rank   = 'phylum'    // phylum | class | order | family | genus
    tree_max_groups   = 12          // groups kept in the legend; rest pooled as 'other'

    // ---- summary (blue dataflow) ---------------------------------------
    collapse_subsets  = true    // count maximal fingerprints only (antichain)
    ambiguous_subset  = 'most_frequent'  // most_frequent | all | drop
    group_by          = 'phylum'         // metadata column for lineage grouping
    rarefaction_knots = 40
    rarefaction_extrapolate = 2.0        // endpoint = 2x observed sampling units
    min_genomes       = 5                // lineages smaller than this skip rarefaction
    rarefaction_ci    = true
    rarefaction_nboot = 0                // 0 = analytic log-transformed CI
    cooccurrence_min_cgc = 100           // families below this excluded from heatmap

    // ---- resources / misc ----------------------------------------------
    max_cpus        = 16
    max_memory      = '64.GB'
    max_time        = '72.h'
    // single image built from the Dockerfile; used by the docker and
    // singularity profiles in place of the per-process biocontainers
    container       = 'mpcgc:1.0.0'
    // the R step is the one process the mpCGC image does not cover, so it uses
    // a stock ggtree image instead of pulling R into the main one
    container_ggtree = 'quay.io/biocontainers/bioconductor-ggtree:3.12.0--r43hdfd78af_0'
    publish_mode    = 'copy'
    // paths used by the local_envs profile
    local_env_dbcan   = "${System.getProperty('user.home')}/miniconda3/envs/dbcan"
    local_env_pydata  = "${System.getProperty('user.home')}/miniconda3/envs/dbcan"
    local_env_network = "${System.getProperty('user.home')}/miniconda3/envs/network"
    local_env_phylo   = "${System.getProperty('user.home')}/miniconda3/envs/gtotree"
    local_env_rggtree = "${System.getProperty('user.home')}/miniconda3/envs/rggtree"

    help            = false
}

// ---- profiles ----------------------------------------------------------
profiles {
    conda {
        conda.enabled          = true
        conda.useMamba         = true
        conda.cacheDir         = "${System.getProperty('user.home')}/.mpcgc/conda"
        docker.enabled         = false
        singularity.enabled    = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        conda.enabled          = false
        singularity.enabled    = false
        process {
            container = params.container
            withName: 'GGTREE_FIGURE' { container = params.container_ggtree }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        process {
            container = params.container
            withName: 'GGTREE_FIGURE' { container = params.container_ggtree }
        }
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = { task.time <= 4.h ? 'short' : 'normal' }
    }
    // Use conda environments that already exist on this machine, without
    // going through Nextflow's conda resolution (which needs conda on PATH).
    // Override the paths with --local_env_dbcan / --local_env_phylo.
    local_envs {
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
        process {
            withLabel: dbcan   { beforeScript = "export PATH=${params.local_env_dbcan}/bin:\$PATH" }
            withLabel: pydata  { beforeScript = "export PATH=${params.local_env_pydata}/bin:\$PATH" }
            withLabel: network { beforeScript = "export PATH=${params.local_env_network}/bin:\$PATH" }
            withLabel: phylo   { beforeScript = "export PATH=${params.local_env_phylo}/bin:\$PATH" }
            withLabel: rggtree { beforeScript = "export PATH=${params.local_env_rggtree}/bin:\$PATH" }
        }
    }
    test      { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ---- reporting ---------------------------------------------------------
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
