/* Small single-genome test: reproduces one mpCGCdb genome. The genome is
 * downloaded from NCBI by Nextflow, so this runs on any machine:
 *   nextflow run AaronAOliver/mpCGC -profile test,conda --db refs/db/dbcan_db
 */
params {
    input             = "${projectDir}/test/samplesheet_test.csv"
    outdir            = 'results_test'
    step              = 'identify'
    // everything else is left at the pipeline defaults, which are the
    // mpCGCdb settings
    methods           = 'diamond,hmm,dbCANsub'
}
