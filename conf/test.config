/* Small single-genome test: reproduces one mpCGCdb genome.
 * nextflow run . -profile test,conda --db /path/to/dbcan_db
 */
params {
    input             = "${projectDir}/test/samplesheet_test.csv"
    outdir            = 'results_test'
    step              = 'identify'
    max_cpus          = 8
    max_memory        = '24.GB'
    // everything else is left at the pipeline defaults, which are the
    // mpCGCdb settings (see docs/validation.md)
    methods           = 'diamond,hmm,dbCANsub'
}
