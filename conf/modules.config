/* publishDir layout, mirroring the three dataflows of Figure 1 */

process {
    // ---- identification (orange) ----
    withName: 'DBCAN_DATABASE' {
        publishDir = [ path: { "${params.outdir}/db" }, mode: params.publish_mode ]
    }
    // DBCAN_ANNOTATE emits one directory per genome; publish it whole so the
    // gene calls, every DIAMOND/HMMER table and overview.tsv are all kept.
    withName: 'DBCAN_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/identify" },
            mode: params.publish_mode,
            pattern: '{*/,*.faa,*.overview.tsv}',
            saveAs: { fn -> fn.endsWith('versions.yml') ? null : fn }
        ]
    }
    // outputs are prefixed with the sample id, e.g. <id>.cgc_standard_out.tsv
    withName: 'DBCAN_CGC' {
        publishDir = [
            path: { "${params.outdir}/identify/cgc" },
            mode: params.publish_mode,
            pattern: '*.{tsv,gff}'
        ]
    }
    withName: 'CGC_CATALOG' {
        publishDir = [ path: { "${params.outdir}/catalog" }, mode: params.publish_mode ]
    }
    withName: 'CGC_PROTEINS' {
        publishDir = [ path: { "${params.outdir}/catalog/proteins" }, mode: params.publish_mode ]
    }

    // ---- mining (green) ----
    withName: 'COLOC_NETWORK' {
        publishDir = [ path: { "${params.outdir}/mine/colocalization" }, mode: params.publish_mode ]
    }
    withName: 'DIAMOND_ALLVSALL' {
        publishDir = [ path: { "${params.outdir}/mine/ssn" }, mode: params.publish_mode, pattern: '*.tsv.gz' ]
    }
    withName: 'LEIDEN_COMMUNITIES' {
        publishDir = [ path: { "${params.outdir}/mine/communities" }, mode: params.publish_mode ]
    }
    withName: 'MUSCLE_ALIGN' {
        publishDir = [ path: { "${params.outdir}/mine/alignments" }, mode: params.publish_mode ]
    }
    withName: 'FASTTREE' {
        publishDir = [ path: { "${params.outdir}/mine/trees" }, mode: params.publish_mode ]
    }
    withName: 'GGTREE_FIGURE' {
        publishDir = [ path: { "${params.outdir}/mine/tree_figures" }, mode: params.publish_mode ]
    }

    // ---- summary (blue) ----
    withName: 'CGC_FINGERPRINT' {
        publishDir = [ path: { "${params.outdir}/summarize" }, mode: params.publish_mode ]
    }
    withName: 'CGC_CLUSTER' {
        publishDir = [ path: { "${params.outdir}/summarize/clustering" }, mode: params.publish_mode ]
    }
    withName: 'CGC_COOCCURRENCE' {
        publishDir = [ path: { "${params.outdir}/summarize/cooccurrence" }, mode: params.publish_mode ]
    }
    withName: 'CGC_RICHNESS' {
        publishDir = [ path: { "${params.outdir}/summarize/richness" }, mode: params.publish_mode ]
    }
    withName: 'SUMMARY_METRICS' {
        publishDir = [ path: { "${params.outdir}/summarize" }, mode: params.publish_mode ]
    }
}
