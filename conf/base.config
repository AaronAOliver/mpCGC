/*
 * Resource defaults. Labels are attached in modules/local/*.nf.
 * resourceLimits caps every request at the params.max_* ceiling, so a retry
 * that doubles its memory can never ask for more than the host provides.
 */

process {
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time   as nextflow.util.Duration
    ]

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: tiny {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: low {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: medium {
        cpus   = 8
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: high {
        cpus   = 16
        memory = { 48.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    // the dbCAN-sub HMM is ~5 GB and PyHMMER preloads it
    withLabel: bigmem {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel: download {
        cpus          = 1
        memory        = 4.GB
        time          = 12.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }
}
